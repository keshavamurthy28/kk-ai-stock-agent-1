import datetime
from datetime import timedelta
import pandas as pd
import streamlit as st
from nselib import capital_market

# 1. Capture the exact dates selected in your UI
start_date, end_date = st.date_input(
    "Select Date Range (From - To)",
    value=(datetime.date.today() - timedelta(days=30), datetime.date.today()),
)

# 2. Format them to match what nselib/API data sources expect (DD-MM-YYYY)
from_str = start_date.strftime("%d-%m-%Y")
to_str = end_date.strftime("%d-%m-%Y")


# 3. Pass these variables dynamically into your fetch function
@st.cache_data(ttl=3600)
def load_deals(f_date, t_date):
  try:
    # Fetching both bulk and block deals using nselib
    df_bulk = capital_market.bulk_deal_data(from_date=f_date, to_date=t_date)
    df_block = capital_market.block_deal_data(from_date=f_date, to_date=t_date)

    # Combine datasets if both return valid dataframes
    frames = [df for df in [df_bulk, df_block] if df is not None and not df.empty]
    if frames:
      df = pd.concat(frames, ignore_index=True)
    else:
      df = pd.DataFrame()

    return df
  except Exception as e:
    st.error(f"Error fetching data from NSE: {e}")
    return pd.DataFrame()


# Load the data
df_deals = load_deals(from_str, to_str)

# 4. Process, format, and enforce secondary pandas filter
if not df_deals.empty:
  # Ensure standard column names mapping (handling variations safely)
  df_deals.columns = [col.strip().title() for col in df_deals.columns]

  # Locate date column dynamically
  date_col = next(
      (c for c in ["Date", "Timestamp", "Trade_Date"] if c in df_deals.columns),
      None,
  )

  if date_col:
    df_deals[date_col] = pd.to_datetime(
        df_deals[date_col], format="%d-%m-%Y", errors="coerce"
    )
    mask = (df_deals[date_col] >= pd.to_datetime(start_date)) & (
        df_deals[date_col] <= pd.to_datetime(end_date)
    )
    df_filtered = df_deals.loc[mask].copy()
  else:
    df_filtered = df_deals.copy()

  # Clean up / standardize Buy/Sell column to accurately show Buy or Sell
  buy_sell_col = next(
      (
          c
          for c in [
              "Buysell",
              "Buy_Sell",
              "B/S",
              "Trade Type",
              "Buy Sell",
              "Remarks",
          ]
          if c in df_filtered.columns
      ),
      None,
  )

  if buy_sell_col:
    # Normalize text to clearly show Buy / Sell
    df_filtered[buy_sell_col] = (
        df_filtered[buy_sell_col].astype(str).str.upper()
    )

  # Display interactive dataframe in Streamlit with customized column configuration if needed
  st.subheader("Institutional Bulk & Block Deals")
  st.dataframe(df_filtered, use_container_width=True)

  # Optional: Quick metric breakdown
  if buy_sell_col and not df_filtered.empty:
    col1, col2 = st.columns(2)
    with col1:
      buys = len(
          df_filtered[df_filtered[buy_sell_col].str.contains("BUY", na=False)]
      )
      st.metric("Total Buy Transactions", buys)
    with col2:
      sells = len(
          df_filtered[df_filtered[buy_sell_col].str.contains("SELL", na=False)]
      )
      st.metric("Total Sell Transactions", sells)
else:
  st.info(
      "No bulk or block deal data found for the selected date range. (Note:"
      " NSE data is only available for active trading days)."
  )
